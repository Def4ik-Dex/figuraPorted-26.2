{
  "schemaVersion": 1,
  "id": "figura",
  "version": "${version}",
  "name": "Figura",
  "description": "Extensive customization of the Player model",
  "authors": ["skyrina", "lumelia", "UnlikePaladin", "omoflop"],
  "contributors": ["TooManyLimits", "Lexize", "KitCat962", "Manuel-3", "superpowers04", "auriafoxgirl", "applejuiceyy"],
  "contact": {
    "homepage": "https://github.com/FiguraMC/Figura",
    "issues": "https://github.com/FiguraMC/Figura/issues"
  },
  "license": "Polyform-Noncommercial-1.0.0",
  "icon": "assets/figura/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["org.figuramc.figura.fabric.FiguraModFabric"],
    "modmenu": ["org.figuramc.figura.config.fabric.ModMenuConfig"]
  },
  "mixins": ["figura.mixins.json", "figura-common.mixins.json"],
  "accessWidener": "figura.accesswidener",
  "depends": {
    "java": ">=25",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}"
  },
  "conflicts": {
    "immersive_portals": "*",
    "canvas": "*",
    "immediatelyfast": "*"
  },
  "custom": {
    "assets_version": "v2",
    "modmenu": {
      "links": {
        "Discord": "https://discord.figuramc.org/",
        "Ko-fi": "https://ko-fi.com/skyrina",
        "Open Collective": "https://opencollective.com/figura",
        "Modrinth": "https://modrinth.com/mod/figura/",
        "GitHub": "https://github.com/FiguraMC/Figura"
      }
    }
  },
  "jars": [
    {"file": "META-INF/jars/fabric-api-base-2.0.3+ece063234c.jar"},
    {"file": "META-INF/jars/fabric-command-api-v2-3.0.5+e2bdee784c.jar"},
    {"file": "META-INF/jars/fabric-key-mapping-api-v1-2.0.4+e2bdee784c.jar"},
    {"file": "META-INF/jars/fabric-resource-loader-v1-2.0.10+7c44c7324c.jar"},
    {"file": "META-INF/jars/luaj-core-3.0.8-figura.jar"},
    {"file": "META-INF/jars/luaj-jse-3.0.8-figura.jar"},
    {"file": "META-INF/jars/mixinextras-fabric-0.3.6.jar"},
    {"file": "META-INF/jars/nv-websocket-client-2.14.jar"}
  ]
}
